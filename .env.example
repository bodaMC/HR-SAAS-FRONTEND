# Server-only Laravel API base URL. Never exposed to the browser.
# Example for a local backend: http://127.0.0.1:8000/api/v1
ORBIT_API_BASE_URL=

# Optional: session cookie lifetime in seconds (defaults to 604800 = 7 days,
# matching the backend's default Sanctum expiration).
# ORBIT_SESSION_MAX_AGE=604800

# Trusted public origin of this app. REQUIRED in production: mutation requests
# are rejected when it is missing or invalid (fail closed), and the session
# cookie Secure flag follows its protocol. The value must be a bare http(s)
# origin - no credentials, path, query or fragment. In production only https
# origins are accepted. Origin checks compare protocol AND host;
# X-Forwarded-Host is never trusted. Example:
# ORBIT_APP_ORIGIN=https://orbit.example.com

# LOCAL TEST HARNESS ONLY: allows an http loopback ORBIT_APP_ORIGIN
# (e.g. http://127.0.0.1:3000) to be trusted in a production BUILD, so the
# production bundle can be exercised on localhost (E2E). Never set this in a
# real deployment; it weakens the Secure cookie and origin policy for that
# loopback origin only.
# ORBIT_ALLOW_INSECURE_LOCAL_ORIGIN=true
